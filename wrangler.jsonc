{
	// BAZZ website: static site on Cloudflare Workers, at https://bazzbooks.store
	"name": "bazz-coffee",
	"compatibility_date": "2026-11-16",
	// tiny Worker: redirects the old workers.dev and www addresses to bazzbooks.store
	"main": "worker/index.js",
	// keep the old workers.dev address on, so old links redirect to bazzbooks.store
	"workers_dev": true,
	// builds ./site before every deploy, so no build command is needed in the dashboard
	"build": {
		"command": "sh build.sh"
	},
	"assets": {
		"directory": "./site",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	// private PDFs, only sent after Wayl says the order is paid
	"r2_buckets": [{ "binding": "BOOKS", "bucket_name": "bazz-books" }],
	// "test" until the test payment works, then "live"
	"vars": { "WAYL_ENV": "test" },
	// order and download logs (proof of delivery for Wayl), free plan
	"observability": { "enabled": true },
	"routes": [
		{ "pattern": "bazzbooks.store", "custom_domain": true },
		{ "pattern": "www.bazzbooks.store", "custom_domain": true }
	]
}
